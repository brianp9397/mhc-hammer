process {
  withLabel: 'mhc-hammer' {
    container = 'docker://brianp9397/mhc-hammer:v1.1'
  }
  withLabel: 'vep' {
    container = 'docker://brianp9397/vep:v1.0'
  }
  //MHC-HAMMER resource allocation
  withLabel:process_single {
    cpus   = 1
    memory = { 2.GB * task.attempt }
  }
  withLabel:process_very_low {
    cpus = { 2 * task.attempt }
    memory = { 4.GB  * task.attempt }
  }
  withLabel:process_low {
    cpus = { 4 * task.attempt }
    memory = { 16.GB  * task.attempt }
  }
  withLabel:process_medium {
    cpus = { 8 * task.attempt }
    memory = { 32.GB * task.attempt }
  }
  withLabel:process_high {
    cpus = { 12    * task.attempt }
    memory = { 72.GB * task.attempt }
  }
  withLabel:process_high_memory {
    memory = { 200.GB * task.attempt }
  }
}

includeConfig './mhc-hammer/mhc-hammer_params.config'
